# =============================================================================
# Profil: NES AMS DfA PoC – Azure-OpenAI-Deployments als Codex-Katalog
# =============================================================================
# Codex-only: registriert pro Deployment ein Codex-Profil
# (codex --profile nes-<deployment>), der Standard (z.B. ChatGPT-Abo) bleibt.
# Anwenden mit --target codex, sonst würde aiprofil auch CC umstellen:
#   aiprofil use nes --target codex --scope user
#   codex-profil use nes --scope user

# Eigener Provider-Eintrag [model_providers.nes], Key in AZURE_NES_API_KEY.
CODEX_PROVIDER_ID=nes
# Codex hängt /responses selbst an, api-version kommt als query_params dazu.
CODEX_BASE_URL=https://sample-resource.cognitiveservices.azure.com/openai
CODEX_API_VERSION=2025-04-01-preview
CODEX_API_KEY=your-azure-api-key

# Deployment-Namen (nicht Modell-Namen), kommagetrennt.
CODEX_MODEL_DEPLOYMENTS=gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-6-astra,gpt-6-luna,gpt-6-sol,gpt-6.1-sol

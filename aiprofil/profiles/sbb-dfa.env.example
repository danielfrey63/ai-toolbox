# =============================================================================
# Devbox Profil: SBB Azure AI Foundry – DFA Account
# =============================================================================

# --- Microsoft Foundry (shared resource; adapters translate per tool) ---
# cc-profil exports these as ANTHROPIC_FOUNDRY_RESOURCE / _API_KEY;
# codex-profil derives base_url and AZURE_OPENAI_API_KEY from them.
CLAUDE_CODE_USE_FOUNDRY=1
FOUNDRY_RESOURCE=sample-azure-ai-foundry-resource
FOUNDRY_API_KEY=your-azure-api-key

# Modelle (ohne Anfuehrungszeichen!)
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# --- Codex CLI projection (consumed by codex-profil; omit to skip Codex) ---
# Name of the GPT deployment on the same Foundry resource (deployment name,
# not model name).
CODEX_MODEL_DEPLOYMENT=gpt-5.6-sol

# --- Kilo Code projection (consumed by kilo-profil; omit to skip Kilo) ---
# KILO_PROVIDER_ID must match a provider.<id> block in kilo.jsonc.
KILO_PROVIDER_ID=sample-anthropic-provider-id
KILO_ACTIVE_MODEL=claude-opus-4-7
KILO_SMALL_MODEL=claude-haiku-4-5

# --- Agent Teams ---
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# --- Git ---
GIT_USER_NAME=sample-git-user
GIT_USER_EMAIL=sample.user@sample.com

# --- SSH-Zugang ---
SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA...dein-public-key-hier

# --- Optional ---
CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=true

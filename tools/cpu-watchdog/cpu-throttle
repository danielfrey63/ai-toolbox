#!/usr/bin/env bash
# Root helper for cpu-watchdog: cap or restore the global CPU performance
# ceiling. Lives in /usr/local/sbin, whitelisted via /etc/sudoers.d/cpu-watchdog
# so the unprivileged watchdog can throttle ANY heat source without knowing
# its name. Fixed verbs and a clamped range keep the sudo surface minimal.
#
# Usage: cpu-throttle set <20-100> | cpu-throttle reset
set -euo pipefail

PSTATE=/sys/devices/system/cpu/intel_pstate/max_perf_pct

usage() { echo "usage: cpu-throttle set <20-100> | cpu-throttle reset" >&2; exit 2; }

case "${1:-}" in
  set)
    pct="${2:-}"
    [[ "$pct" =~ ^[0-9]+$ ]] || usage
    (( pct < 20 )) && pct=20
    (( pct > 100 )) && pct=100
    ;;
  reset) pct=100 ;;
  *) usage ;;
esac

if [ -w "$PSTATE" ]; then
  echo "$pct" > "$PSTATE"
  echo "intel_pstate max_perf_pct=$pct"
  exit 0
fi

# cpufreq fallback: scale each core's max frequency linearly into its
# [cpuinfo_min_freq, cpuinfo_max_freq] range.
found=0
for cpu in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
  [ -w "$cpu/scaling_max_freq" ] || continue
  min=$(cat "$cpu/cpuinfo_min_freq")
  max=$(cat "$cpu/cpuinfo_max_freq")
  echo $(( min + (max - min) * pct / 100 )) > "$cpu/scaling_max_freq"
  found=1
done
[ "$found" -eq 1 ] || { echo "no throttling interface found" >&2; exit 1; }
echo "cpufreq scaling_max_freq capped to ${pct}% of range"

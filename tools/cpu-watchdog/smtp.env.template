# SMTP-Zugang für cpu-watchdog-Mails — Werte eintragen, Datei bleibt chmod 600.
# Solange SMTP_PASS leer ist, wird der Mail-Kanal einfach übersprungen.
#
# Wichtig: Als SMTP_USER die Mailbox-ID verwenden (z.B. mailbox2@example.ch),
# nicht eine Alias-Adresse — Alias-Logins lehnt der Server mit 535 ab.

SMTP_URL="smtps://mail.example.ch:465"
SMTP_USER=""
SMTP_PASS=""

# Optional; Default ist jeweils SMTP_USER.
MAIL_FROM=""
MAIL_TO=""

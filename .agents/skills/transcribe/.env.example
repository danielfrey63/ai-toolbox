# Generated by transcribe config template. Do not edit this template.
# Copy values into the user .env or an explicit --config file.
# Environment > explicit file > user file > default; blank means unset.
# Local-first can fall back to configured cloud providers. Use --local to pin audio processing.

# Provider for analysis; none delegates to the harness.
# TRANSCRIBE_LLM_PROVIDER=auto
# Azure resource base URL.
AZURE_LLM_ENDPOINT=
# Azure analysis API key.
AZURE_LLM_KEY=
# AZURE_LLM_API_VERSION=2024-10-21
# Text deployment.
# AZURE_LLM_MODEL=gpt-6.1-sol
# Vision deployment; unset uses the text deployment.
AZURE_LLM_MODEL_VISION=
# Triage deployment; unset uses the text deployment.
AZURE_LLM_MODEL_FAST=
# Default completion budget; stages may request their own budget.
# AZURE_LLM_MAX_TOKENS=4096
# AZURE_LLM_TIMEOUT=300
AZURE_CLAUDE_URL=
AZURE_CLAUDE_KEY=
# AZURE_CLAUDE_MODEL=claude-opus-4-7
# Full Azure audio endpoint, including api-version.
AZURE_TRANSCRIBE_DIARIZE_URL=
AZURE_TRANSCRIBE_DIARIZE_KEY=
# AZURE_TRANSCRIBE_CHUNK_SECONDS=600
# AZURE_TRANSCRIBE_OVERLAP_SECONDS=20
# AZURE_TRANSCRIBE_TIMEOUT=900
GROQ_API_KEY=
OPENAI_API_KEY=
# Hugging Face token; model licence acceptance is also required.
HF_TOKEN=
# Compatibility alias for HF_TOKEN.
HUGGINGFACE_TOKEN=
PYANNOTE_API_KEY=
ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_REGION=us
# Shared CPU budget; percentage, positive thread count or all.
# TRANSCRIBE_CPU_BUDGET=50%
# TRANSCRIBE_WHISPER_MODEL=large-v3-turbo
# TRANSCRIBE_GPU_COMPUTE=float16
# TRANSCRIBE_GPU_DUTY=1
# TRANSCRIBE_OCR_ACCEL=auto
# Unset keeps existing crop redaction (off on a new run); source images still reach the analysis model.
TRANSCRIBE_REDACT=
# Maximum concurrent independent chapter calls.
# TRANSCRIBE_LLM_WORKERS=2
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
# CONFLUENCE_VERIFY_TLS=1
# Optional PEM CA bundle for an internal server.
CONFLUENCE_CA_BUNDLE=
# Managed installation marker; doctor remains authoritative.
# SETUP_COMPLETE=false
# DIARIZE_DISMISSED=false

# aiprofil — real profile .env files hold live API/foundry/SSH keys; only the
# *.example templates and .managed-vars are committed. The legacy cc-profil/
# path is kept ignored too, for installs that still carry profiles there.
aiprofil/profiles/*.env
!aiprofil/profiles/*.env.example
cc-profil/profiles/*.env
!cc-profil/profiles/*.env.example

# oracle-skill — real connection config holds DB host/user/password; only the
# *.tmpl templates are committed.
.agents/skills/oracle-skill/config/oracle.env

# Python bytecode caches (py_compile / test runs on the skill scripts)
__pycache__/

# drive-sync — downloaded Google OAuth client secret and any local sync state
drive-sync/client_secret_*.json
drive-sync/*.log
drive-sync/filters.txt.md5
